# IBM Cloud API Key
# Get your API key from: https://cloud.ibm.com/iam/apikeys
ibmcloud_api_key = "your-ibm-cloud-api-key-here"

# IBM Cloud Region
# Example: us-south, us-east, eu-gb, eu-de, jp-tok, au-syd
ibmcloud_region = "us-south"

# IBM Cloud Zone
# Example: us-south-1, us-south-2, us-south-3
ibmcloud_zone = "us-south-1"

# IBM Cloud Internet Services (CIS) CRN
# Get this from your CIS instance details page
# Format: crn:v1:bluemix:public:internet-svcs:global:a/<account-id>:<instance-id>::
ibm_cloud_cis_crn = "crn:v1:bluemix:public:internet-svcs:global:a/your-account-id:your-instance-id::"

# Cluster Domain
# The domain name registered in your CIS instance
cluster_domain = "example.com"